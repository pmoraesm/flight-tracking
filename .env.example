TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxYZ
TELEGRAM_CHAT_ID=987654321

# PostgreSQL connection string. Locally, this points at the docker-compose
# "postgres" dev service (docker compose --profile dev up -d postgres). On
# the VPS, this points at the host pg-shared (the shared PostgreSQL
# container, governed by the vps-infra project) and must never be committed
# here. The container uses the shared network "platform" only.
DATABASE_URL=postgresql://flight_tracker:flight_tracker_dev@localhost:5432/flight_tracker

# /set-config talks to the claude-relay-server on this VPS over the Docker
# network "platform" — no key needed here. The relay listens on the gateway
# of "platform" (172.30.0.1). relay_client.py reads this gateway from the
# routing table of the container.
